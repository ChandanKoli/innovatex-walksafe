---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Hazard Priorities | WalkSafe">
    <div class="max-w-xl mx-auto px-4 py-8 md:py-12 min-h-[calc(100vh-3.5rem)] flex flex-col justify-center">
        <a href="/" class="text-sm font-semibold text-emerald-600 flex items-center gap-1 mb-6 hover:text-emerald-700 w-fit transition">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
            Back to Home
        </a>

        <div class="bg-white rounded-3xl border border-slate-200 shadow-xl p-6 md:p-8">
            <h1 class="text-2xl font-extrabold text-slate-900 mb-2 flex items-center gap-3">
                <svg class="w-7 h-7 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
                Hazard Priorities
            </h1>
            <p class="text-sm text-slate-500 mb-6">Set your avoidance intensity from 1 (Standard) to 4 (Critical).</p>
            
            <div class="space-y-4">
                <!-- Dust -->
                <div class="bg-slate-50 border border-slate-100 p-4 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <div class="bg-amber-100 p-2 rounded-lg text-amber-600">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                        </div>
                        <div>
                            <h3 class="text-sm font-bold text-slate-800">Active Road Dust</h3>
                            <p class="text-[11px] text-slate-500">Fugitive PM10 & Excavation</p>
                        </div>
                    </div>
                    <div class="flex gap-1 bg-white border border-slate-200 p-1 rounded-lg">
                        <button class="w-8 h-8 rounded text-sm font-semibold bg-amber-50 text-amber-700 border border-amber-200">1</button>
                        <button class="w-8 h-8 rounded text-sm font-semibold text-slate-400 hover:bg-slate-50 transition">2</button>
                        <button class="w-8 h-8 rounded text-sm font-semibold text-slate-400 hover:bg-slate-50 transition">3</button>
                        <button class="w-8 h-8 rounded text-sm font-semibold text-slate-400 hover:bg-slate-50 transition">4</button>
                    </div>
                </div>

                <!-- Odor -->
                <div class="bg-slate-50 border border-slate-100 p-4 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <div class="bg-teal-100 p-2 rounded-lg text-teal-600">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" /></svg>
                        </div>
                        <div>
                            <h3 class="text-sm font-bold text-slate-800">Drain & Waste Odor</h3>
                            <p class="text-[11px] text-slate-500">VOCs / Sewage gas</p>
                        </div>
                    </div>
                    <div class="flex gap-1 bg-white border border-slate-200 p-1 rounded-lg">
                        <button class="w-8 h-8 rounded text-sm font-semibold text-slate-400 hover:bg-slate-50 transition">1</button>
                        <button class="w-8 h-8 rounded text-sm font-semibold text-slate-400 hover:bg-slate-50 transition">2</button>
                        <button class="w-8 h-8 rounded text-sm font-semibold bg-teal-50 text-teal-700 border border-teal-200">3</button>
                        <button class="w-8 h-8 rounded text-sm font-semibold text-slate-400 hover:bg-slate-50 transition">4</button>
                    </div>
                </div>

                <!-- Smog -->
                <div class="bg-slate-50 border border-slate-100 p-4 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <div class="bg-orange-100 p-2 rounded-lg text-orange-600">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" /></svg>
                        </div>
                        <div>
                            <h3 class="text-sm font-bold text-slate-800">Smog & Burning</h3>
                            <p class="text-[11px] text-slate-500">Black Carbon / Smoke</p>
                        </div>
                    </div>
                    <div class="flex gap-1 bg-white border border-slate-200 p-1 rounded-lg">
                        <button class="w-8 h-8 rounded text-sm font-semibold text-slate-400 hover:bg-slate-50 transition">1</button>
                        <button class="w-8 h-8 rounded text-sm font-semibold bg-orange-50 text-orange-700 border border-orange-200">2</button>
                        <button class="w-8 h-8 rounded text-sm font-semibold text-slate-400 hover:bg-slate-50 transition">3</button>
                        <button class="w-8 h-8 rounded text-sm font-semibold text-slate-400 hover:bg-slate-50 transition">4</button>
                    </div>
                </div>

                <!-- Idling -->
                <div class="bg-slate-50 border border-slate-100 p-4 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <div class="bg-red-100 p-2 rounded-lg text-red-600">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg>
                        </div>
                        <div>
                            <h3 class="text-sm font-bold text-slate-800">Transit Idling</h3>
                            <p class="text-[11px] text-slate-500">Tailpipe NOx & Soot</p>
                        </div>
                    </div>
                    <div class="flex gap-1 bg-white border border-slate-200 p-1 rounded-lg">
                        <button class="w-8 h-8 rounded text-sm font-semibold text-slate-400 hover:bg-slate-50 transition">1</button>
                        <button class="w-8 h-8 rounded text-sm font-semibold bg-red-50 text-red-700 border border-red-200">2</button>
                        <button class="w-8 h-8 rounded text-sm font-semibold text-slate-400 hover:bg-slate-50 transition">3</button>
                        <button class="w-8 h-8 rounded text-sm font-semibold text-slate-400 hover:bg-slate-50 transition">4</button>
                    </div>
                </div>
            </div>
            
            <button class="w-full bg-slate-900 hover:bg-slate-800 text-white font-bold py-3.5 rounded-xl shadow-sm transition mt-6">
                Save Priorities
            </button>
        </div>
    </div>
</Layout>
