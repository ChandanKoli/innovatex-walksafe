---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Vashi Demo Sandbox | WalkSafe">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    
    <style is:global>
        .leaflet-tile-pane { filter: grayscale(100%) opacity(50%) contrast(110%); }
        html.dark .leaflet-tile-pane { filter: invert(100%) hue-rotate(180deg) brightness(85%) contrast(90%); }
        
        /* Bulletproof Dark Mode UI Overrides */
        html.dark .shadow-2xl, html.dark .shadow-xl { background-color: #161b22 !important; border-color: #30363d !important; }
        
        html.dark select { background-color: #0d1117 !important; color: #F7FAFC !important; border-color: #30363d !important; }
        html.dark option { background-color: #0d1117 !important; color: #F7FAFC !important; }
        html.dark .text-slate-900, html.dark h2, html.dark h3 { color: #F7FAFC !important; }
        html.dark .text-slate-800 { color: #e2e8f0 !important; }
        html.dark .bg-slate-100, html.dark .bg-slate-50 { background-color: #0d1117 !important; border-color: #30363d !important; }
        html.dark #stat-time-dist { color: #F7FAFC !important; }
        html.dark #stat-compare { color: #94a3b8 !important; }
        html.dark #stat-alert { background-color: rgba(217, 119, 6, 0.15) !important; color: #fbbf24 !important; border-color: rgba(217, 119, 6, 0.3) !important; }
        html.dark .toggle-btn { color: #94a3b8 !important; background: transparent !important; border: none !important; }
        html.dark .toggle-btn:hover { color: #F7FAFC !important; }
        
        html.dark .hazard-tag { background-color: #0d1117 !important; border-color: #30363d !important; }
        html.dark .hazard-tag:hover { border-color: #10b981 !important; }
        html.dark .hazard-tag .text-slate-800 { color: #f1f5f9 !important; }
        html.dark .hazard-tag .text-slate-500 { color: #94a3b8 !important; }
        html.dark #btn-clean-path.active { background-color: #064e3b !important; color: #34d399 !important; }
        html.dark #btn-arterial-path.active { background-color: #1e293b !important; color: #94a3b8 !important; }
        
        .leaflet-tooltip { color: #0f172a !important; }
    </style>
    
    <div class="relative w-full h-[calc(100vh-4rem)] bg-slate-100 dark:bg-slate-900 overflow-hidden">
        <div id="demo-map" class="absolute top-0 h-[50vh] sm:h-[70vh] md:h-full w-full z-0 bg-slate-50 dark:bg-slate-900"></div>

        <div class="absolute bottom-0 md:inset-0 w-full z-[1000] pointer-events-none p-4 md:p-0 flex flex-col max-h-[50vh] md:max-h-none overflow-y-auto md:overflow-visible gap-4">
            <!-- Top Left Card -->
            <div class="w-full md:absolute md:top-4 md:left-4 z-[400] md:w-96 flex flex-col gap-4 pointer-events-auto">
                <div class="backdrop-blur-md bg-white/90 dark:bg-slate-900/90 border border-slate-200 dark:border-slate-700 shadow-xl rounded-xl p-5 md:p-6 transition-all">
                    <div class="flex items-center justify-between w-full">
                        <h2 class="text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span> Route Trade-Off
                        </h2>
                        <button class="toggle-btn text-xs font-bold text-slate-400 dark:text-slate-500 hover:text-slate-800 dark:hover:text-slate-300 transition tracking-wide bg-transparent border-0 px-1 py-1 uppercase">▼ Hide</button>
                    </div>
                    
                    <div class="card-body mt-4 transition-all">
                        <div class="flex flex-col gap-2 mb-4">
                            <div class="flex items-center bg-slate-50/50 dark:bg-slate-800/50 border border-slate-200/50 dark:border-slate-700/50 rounded-xl px-3 py-2">
                                <span class="text-[10px] font-extrabold text-slate-400 dark:text-slate-500 w-12 tracking-wider">FROM</span>
                                <select id="origin-select" class="flex-1 bg-transparent text-sm font-bold text-slate-800 dark:text-white focus:outline-none cursor-pointer">
                                    <option value="none" selected disabled class="dark:bg-slate-900">Select Origin...</option>
                                    <option value="nodeA" class="dark:bg-slate-900">Node A (Vashi Station)</option>
                                    <option value="nodeB" class="dark:bg-slate-900">Node B (Mini Seashore)</option>
                                    <option value="nodeC" class="dark:bg-slate-900">Node C (Galleria 17)</option>
                                    <option value="nodeD" class="dark:bg-slate-900">Node D (Bus Depot)</option>
                                </select>
                            </div>
                            <div class="flex items-center bg-slate-50/50 dark:bg-slate-800/50 border border-slate-200/50 dark:border-slate-700/50 rounded-xl px-3 py-2">
                                <span class="text-[10px] font-extrabold text-slate-400 dark:text-slate-500 w-12 tracking-wider">TO</span>
                                <select id="dest-select" class="flex-1 bg-transparent text-sm font-bold text-slate-800 dark:text-white focus:outline-none cursor-pointer">
                                    <option value="none" selected disabled class="dark:bg-slate-900">Select Destination...</option>
                                    <option value="nodeA" class="dark:bg-slate-900">Node A (Vashi Station)</option>
                                    <option value="nodeB" class="dark:bg-slate-900">Node B (Mini Seashore)</option>
                                    <option value="nodeC" class="dark:bg-slate-900">Node C (Galleria 17)</option>
                                    <option value="nodeD" class="dark:bg-slate-900">Node D (Bus Depot)</option>
                                </select>
                            </div>
                        </div>

                        <div id="route-toggle-group" class="flex bg-slate-100 dark:bg-slate-900/50 p-1 rounded-xl mb-4 transition opacity-50 pointer-events-none">
                            <button id="btn-clean-path" class="flex-1 py-2 rounded-lg text-xs font-bold text-slate-500 dark:text-slate-400 transition">
                                Route: N/A
                            </button>
                            <button id="btn-arterial-path" class="flex-1 py-2 rounded-lg text-xs font-semibold text-slate-400 dark:text-slate-500 transition">
                                Arterial: N/A
                            </button>
                        </div>
                        <div class="space-y-3 bg-slate-50 dark:bg-slate-800 rounded-xl p-4 border border-slate-100 dark:border-slate-700">
                            <div class="flex items-start gap-3">
                                <div>
                                    <div id="stat-exposure" class="text-sm font-bold text-slate-900 dark:text-white">-42% Dust Exposure</div>
                                    <div class="text-[10px] text-slate-500 dark:text-slate-400 uppercase tracking-wide mt-0.5">Modelled Hyperlocal Estimate</div>
                                </div>
                            </div>
                            <div class="flex items-start gap-3">
                                <div class="text-sm font-medium text-slate-700 dark:text-slate-300">
                                    <span id="stat-time-dist">Calculating...</span>
                                    <span id="stat-compare" class="text-xs text-slate-400 dark:text-slate-500 ml-1"></span>
                                </div>
                            </div>
                            <div id="stat-alert" class="mt-3 text-xs font-medium text-amber-800 dark:text-amber-400 bg-amber-100/50 dark:bg-amber-900/20 p-2.5 rounded-lg border border-amber-200 dark:border-amber-900/50">
                                Dynamically routing to avoid localized high-exposure zones.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hazard Menu -->
            <div class="w-full sm:w-auto sm:self-end md:absolute md:bottom-8 md:right-4 z-[400] md:w-80 pointer-events-auto mt-auto">
                <div class="backdrop-blur-md bg-white/90 dark:bg-slate-900/90 border border-slate-200 dark:border-slate-700 shadow-xl rounded-xl p-5 md:p-6 w-full sm:w-[360px] md:w-full transition-all">
                    <div class="flex items-center justify-between w-full mb-3">
                        <h3 class="text-sm font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
                            Report Street Hazard
                        </h3>
                        <button class="toggle-btn text-xs font-bold text-slate-400 dark:text-slate-500 hover:text-slate-800 dark:hover:text-slate-300 transition tracking-wide bg-transparent border-0 px-1 py-1 uppercase">▼ Hide</button>
                    </div>
                    <div class="card-body">
                        <p class="text-[11px] text-slate-500 dark:text-slate-300 mb-3">Tag real-time pedestrian obstruction or microclimate penalty:</p>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5" id="hazard-grid">
                            <button class="hazard-tag py-2.5 px-3 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-left hover:border-amber-400 dark:hover:border-amber-500 transition">
                                <div class="flex items-center gap-1.5 text-xs font-bold text-slate-800 dark:text-white">
                                    <span class="w-2 h-2 rounded-full bg-amber-500"></span> Dust / Debris
                                </div>
                                <div class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">Unpaved or building site</div>
                            </button>
                            <button class="hazard-tag py-2.5 px-3 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-left hover:border-emerald-400 dark:hover:border-emerald-500 transition">
                                <div class="flex items-center gap-1.5 text-xs font-bold text-slate-800 dark:text-white">
                                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Open Waste
                                </div>
                                <div class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">Garbage or storm drain odor</div>
                            </button>
                            <button class="hazard-tag py-2.5 px-3 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-left hover:border-orange-400 dark:hover:border-orange-500 transition">
                                <div class="flex items-center gap-1.5 text-xs font-bold text-slate-800 dark:text-white">
                                    <span class="w-2 h-2 rounded-full bg-orange-500"></span> Stagnant Smog
                                </div>
                                <div class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">Heavy corridor idling</div>
                            </button>
                            <button class="hazard-tag py-2.5 px-3 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-left hover:border-rose-400 dark:hover:border-rose-500 transition">
                                <div class="flex items-center gap-1.5 text-xs font-bold text-slate-800 dark:text-white">
                                    <span class="w-2 h-2 rounded-full bg-rose-500"></span> Bus Exhaust
                                </div>
                                <div class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">High soot diesel pocket</div>
                            </button>
                        </div>
                        <div id="hazard-toast" class="hidden mt-3 text-center text-xs font-bold text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-900/30 border border-emerald-200 dark:border-emerald-800 py-1.5 rounded-lg">
                            ✓ Hazard logged to exposure engine
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const map = L.map('demo-map', { zoomControl: false, attributionControl: false }).setView([19.0740, 72.9960], 15);
            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 18, minZoom: 14 }).addTo(map);

            const vashiBounds = L.latLngBounds([19.0600, 72.9800], [19.0900, 73.0150]);
            map.setMaxBounds(vashiBounds);
            map.on('drag', () => { map.panInsideBounds(vashiBounds, { animate: false }); });

            // ---> YOUR CUSTOM PAINT COORDINATES GO HERE <---
            const nodes = {
                nodeA: [19.0645, 72.9972], // Replace with Node A
                nodeB: [19.0815, 72.9930], // Replace with Node B
                nodeC: [19.0735, 72.9985], // Replace with Node C
                nodeD: [19.0756, 72.9977]  // Replace with Node D
            };

            const nodeNames = {
                nodeA: "Node A: Station",
                nodeB: "Node B: Mini Seashore",
                nodeC: "Node C: Galleria 17",
                nodeD: "Node D: Bus Depot"
            };

            const createNodeIcon = () => L.divIcon({
                className: 'custom-div-icon', html: `<div style="background:white; border: 2px solid #059669; border-radius: 50%; width: 14px; height: 14px; box-shadow: 0 0 10px rgba(0,0,0,0.3);"></div>`, iconSize: [14, 14], iconAnchor: [7, 7]
            });

            // Isolate layers for dynamic clearing
            let activeMarkersLayer = L.layerGroup().addTo(map);
            let cleanRouteLayer = L.layerGroup().addTo(map);
            let directRouteLayer = L.layerGroup().addTo(map);

            const waypoints = {
                "nodeA-nodeB": [19.0720, 72.9940], "nodeA-nodeC": [19.0690, 73.0010],
                "nodeA-nodeD": [19.0680, 72.9920], "nodeB-nodeC": [19.0780, 72.9980],
                "nodeB-nodeD": [19.0770, 72.9920], "nodeC-nodeD": [19.0750, 72.9950]
            };

            const getMidpoint = (orig, dest) => {
                if (waypoints[`${orig}-${dest}`]) return waypoints[`${orig}-${dest}`];
                if (waypoints[`${dest}-${orig}`]) return waypoints[`${dest}-${orig}`];
                return [(nodes[orig][0] + nodes[dest][0])/2, (nodes[orig][1] + nodes[dest][1])/2];
            };

            const fetchOSRM = async (points) => {
                const coords = points.map(p => `${p[1]},${p[0]}`).join(';');
                try {
                    const res = await fetch(`https://router.project-osrm.org/route/v1/foot/${coords}?overview=full&geometries=geojson`);
                    const data = await res.json();
                    return data.routes[0].geometry.coordinates.map(c => [c[1], c[0]]);
                } catch(e) { return points; }
            };

            const updateRoute = async () => {
                const orig = document.getElementById('origin-select').value;
                const dest = document.getElementById('dest-select').value;
                
                cleanRouteLayer.clearLayers();
                directRouteLayer.clearLayers();
                activeMarkersLayer.clearLayers();

                // NEW: Handle empty initial state
                if (orig === 'none' || dest === 'none') {
                    document.getElementById('stat-alert').innerText = "Select an Origin and Destination to calculate route trade-offs.";
                    document.getElementById('stat-time-dist').innerText = "-- mins • -- km";
                    document.getElementById('stat-compare').innerText = "";
                    document.getElementById('stat-exposure').innerText = "Awaiting Route Selection";
                    
                    const routeToggleGroup = document.getElementById('route-toggle-group');
                    if (routeToggleGroup) routeToggleGroup.classList.add('opacity-50', 'pointer-events-none');
                    const btnCleanPath = document.getElementById('btn-clean-path');
                    if (btnCleanPath) {
                        btnCleanPath.innerText = "Route: N/A";
                        btnCleanPath.className = "flex-1 py-2 rounded-lg text-xs font-bold text-slate-500 transition";
                    }
                    const btnArterialPath = document.getElementById('btn-arterial-path');
                    if (btnArterialPath) {
                        btnArterialPath.innerText = "Arterial: N/A";
                        btnArterialPath.className = "flex-1 py-2 rounded-lg text-xs font-semibold text-slate-400 transition";
                    }
                    

                    
                    map.setView([19.0740, 72.9960], 15);
                    return;
                }

                // Dynamically render ONLY the selected Origin and Destination markers
                L.marker(nodes[orig], {icon: createNodeIcon()}).addTo(activeMarkersLayer).bindTooltip(nodeNames[orig], {permanent: true, direction: 'bottom', className: 'text-xs font-bold mt-1 bg-white/90 border-0 shadow-sm rounded px-1'}).openTooltip();
                
                if (orig === dest) {
                    document.getElementById('stat-alert').innerText = "Origin and Destination cannot be the same.";
                    document.getElementById('stat-time-dist').innerText = "--";
                    document.getElementById('stat-compare').innerText = "";
                    return;
                }

                L.marker(nodes[dest], {icon: createNodeIcon()}).addTo(activeMarkersLayer).bindTooltip(nodeNames[dest], {permanent: true, direction: 'bottom', className: 'text-xs font-bold mt-1 bg-white/90 border-0 shadow-sm rounded px-1'}).openTooltip();

                document.getElementById('stat-alert').innerText = `Dynamically routing to avoid localized high-exposure zones on standard arterials.`;
                document.getElementById('stat-time-dist').innerText = "Calculating...";
                document.getElementById('stat-exposure').innerText = "-42% Dust Exposure";

                const midPoint = getMidpoint(orig, dest);
                const cleanCoords = await fetchOSRM([nodes[orig], midPoint, nodes[dest]]);
                const directCoords = await fetchOSRM([nodes[orig], nodes[dest]]);

                const dist = (L.latLng(nodes[orig]).distanceTo(L.latLng(nodes[dest])) / 1000).toFixed(1);
                document.getElementById('stat-time-dist').innerText = `~${Math.round(dist * 12 + 4)} mins • ${dist}km`;
                document.getElementById('stat-compare').innerText = `(vs ${Math.round(dist * 10)} mins direct)`;

                const routeToggleGroup = document.getElementById('route-toggle-group');
                if (routeToggleGroup) routeToggleGroup.classList.remove('opacity-50', 'pointer-events-none');
                
                const btnCleanPath = document.getElementById('btn-clean-path');
                if (btnCleanPath) {
                    btnCleanPath.className = "flex-1 py-2 bg-white shadow-sm rounded-lg text-xs font-bold text-emerald-700 border border-slate-200 active transition";
                    btnCleanPath.innerText = "WalkSafe Clean Path";
                }
                
                const btnArterialPath = document.getElementById('btn-arterial-path');
                if (btnArterialPath) {
                    btnArterialPath.className = "flex-1 py-2 rounded-lg text-xs font-semibold text-slate-500 transition";
                    btnArterialPath.innerText = "Direct Arterial";
                }

                L.polyline(directCoords, {color: '#94a3b8', weight: 4, dashArray: '8, 8', opacity: 0.8}).addTo(directRouteLayer);
                L.polyline(cleanCoords, {color: '#059669', weight: 6, opacity: 0.9}).addTo(cleanRouteLayer);
                
                map.fitBounds(L.latLngBounds(cleanCoords.concat(directCoords)), {padding: [50, 50], maxZoom: 16});
            };

            document.getElementById('origin-select').addEventListener('change', updateRoute);
            document.getElementById('dest-select').addEventListener('change', updateRoute);
            updateRoute();
            
            // Reusable Collapse Logic
            document.querySelectorAll('.toggle-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const card = e.target.closest('.bg-white\\/95');
                    const body = card.querySelector('.card-body');
                    if(body.classList.contains('hidden')) {
                        body.classList.remove('hidden');
                        e.target.innerText = '▼ Hide';
                    } else {
                        body.classList.add('hidden');
                        e.target.innerText = '▲ Show';
                    }
                });
            });

            // Hazard Button Interactivity
            document.querySelectorAll('.hazard-tag').forEach(btn => {
                btn.addEventListener('click', () => {
                    const toast = document.getElementById('hazard-toast');
                    if(toast) {
                        toast.classList.remove('hidden');
                        setTimeout(() => toast.classList.add('hidden'), 2500);
                    }
                });
            });
        });
    </script>
</Layout>
