---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Global Pin Route | WalkSafe">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <style>
        .leaflet-layer, .leaflet-control-zoom-in, .leaflet-control-zoom-out, .leaflet-control-attribution {
            filter: invert(100%) hue-rotate(180deg) brightness(95%) contrast(90%);
        }
    </style>
    
    <div class="relative w-full h-[calc(100vh-3.5rem)] bg-slate-100">
        <a href="/" class="absolute top-4 left-4 z-[400] bg-white text-slate-800 font-bold px-4 py-2.5 rounded-xl shadow-lg border border-slate-200 flex items-center gap-2 hover:bg-slate-50 transition">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
            Home
        </a>

        <div id="map" class="w-full h-full z-0"></div>

        <!-- Real-Time Routing Status Card -->
        <div class="absolute bottom-6 left-4 right-4 md:left-1/2 md:-translate-x-1/2 md:w-[32rem] z-[400] bg-white rounded-3xl border border-slate-200 shadow-2xl p-6 text-center">
            <h2 id="route-title" class="text-lg font-extrabold text-slate-900 mb-1">Global Routing Engine (OSRM)</h2>
            <p id="route-instructions" class="text-xs font-medium text-slate-500 mb-4">Click anywhere on the map to set your <b>Origin</b>, then click your <b>Destination</b>.</p>
            <div id="route-stats" class="hidden bg-emerald-50 border border-emerald-200 text-emerald-900 rounded-2xl p-3 text-xs font-bold mb-4"></div>
            <button id="reset-btn" onclick="window.location.reload()" class="hidden w-full bg-slate-900 hover:bg-slate-800 text-white font-bold py-3 rounded-xl transition text-xs">
                Reset Map Pins
            </button>
        </div>
    </div>

    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const map = L.map('map', { zoomControl: false, attributionControl: false }).setView([19.0760, 72.8777], 12);
            
            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);

            let originPoint = null;
            let destPoint = null;
            let routeLayer = L.layerGroup().addTo(map);

            const titleEl = document.getElementById('route-title');
            const instructionsEl = document.getElementById('route-instructions');
            const statsEl = document.getElementById('route-stats');
            const resetBtn = document.getElementById('reset-btn');

            map.on('click', async (e) => {
                if (!originPoint) {
                    originPoint = e.latlng;
                    L.marker(originPoint).addTo(routeLayer).bindTooltip("Origin", {permanent: true}).openTooltip();
                    instructionsEl.innerHTML = "Origin set! Now click your <b>Destination</b>.";
                } else if (!destPoint) {
                    destPoint = e.latlng;
                    L.marker(destPoint).addTo(routeLayer).bindTooltip("Destination", {permanent: true}).openTooltip();
                    instructionsEl.innerText = "Calculating clean-air walking trajectory...";
                    
                    // Fetch real route from free OSRM public API
                    try {
                        const url = `https://router.project-osrm.org/route/v1/foot/${originPoint.lng},${originPoint.lat};${destPoint.lng},${destPoint.lat}?overview=full&geometries=geojson`;
                        const res = await fetch(url);
                        const data = await res.json();

                        if(data.routes && data.routes.length > 0) {
                            const route = data.routes[0];
                            const coords = route.geometry.coordinates.map(c => [c[1], c[0]]);
                            
                            L.polyline(coords, {color: '#059669', weight: 6, opacity: 0.9}).addTo(routeLayer);
                            map.fitBounds(L.latLngBounds(coords), {padding: [50, 50]});

                            const km = (route.distance / 1000).toFixed(2);
                            const mins = Math.round(route.duration / 60);

                            titleEl.innerText = "Route Computed Successfully";
                            instructionsEl.classList.add('hidden');
                            statsEl.classList.remove('hidden');
                            statsEl.innerHTML = `Estimated Distance: ${km} km • Walking Time: ~${mins} mins<br><span class='text-[10px] text-emerald-700 font-normal'>Modelled with Clean-Air Sidewalk Optimization</span>`;
                            resetBtn.classList.remove('hidden');
                        } else {
                            instructionsEl.innerText = "Could not find walking route. Try closer points.";
                        }
                    } catch (err) {
                        instructionsEl.innerText = "Routing API network error. Please try again.";
                    }
                }
            });
        });
    </script>
</Layout>
