---
import '../styles/global.css';
---
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Profile — WalkSafe</title>
</head>
<body class="bg-slate-50 text-slate-900 font-sans min-h-screen flex flex-col antialiased">
    <!-- Top Bar -->
    <header class="bg-emerald-600 text-white p-4 shadow-sm sticky top-0 z-10">
        <div class="max-w-xl mx-auto flex items-center justify-between">
            <a href="/menu" class="text-emerald-50 hover:text-white font-medium flex items-center gap-1 transition">
                <span>&larr;</span> <span class="hidden sm:inline">Back</span>
            </a>
            <h1 class="text-lg font-bold">Commuter Profile</h1>
            <div class="w-12"></div> <!-- Spacer -->
        </div>
    </header>

    <main class="flex-grow p-4 relative">
        <div class="max-w-xl mx-auto my-8 bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-8 flex flex-col gap-6">
            
            <form id="profile-form" class="flex flex-col gap-6">
                <!-- Field 1: Name -->
                <div class="flex flex-col gap-2">
                    <label for="commuter-name" class="font-semibold text-slate-800">Commuter Display Name</label>
                    <input type="text" id="commuter-name" name="name" placeholder="e.g. Chandan Koli" 
                        class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-slate-50 text-slate-900" />
                </div>

                <!-- Field 2: Pace -->
                <div class="flex flex-col gap-3">
                    <label class="font-semibold text-slate-800">Walking Velocity / Commuter Pace</label>
                    <div class="flex flex-col gap-2">
                        <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 cursor-pointer hover:bg-slate-50 has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-50/50 transition">
                            <input type="radio" name="pace" value="relaxed" class="mt-1 accent-emerald-600" />
                            <div>
                                <div class="font-medium">Relaxed (3.0 km/h)</div>
                                <div class="text-sm text-slate-500">Lower respiratory volume, extended commute duration.</div>
                            </div>
                        </label>
                        <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 cursor-pointer hover:bg-slate-50 has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-50/50 transition">
                            <input type="radio" name="pace" value="standard" checked class="mt-1 accent-emerald-600" />
                            <div>
                                <div class="font-medium">Standard Commuter (4.5 km/h)</div>
                                <div class="text-sm text-slate-500">Typical transit walking velocity.</div>
                            </div>
                        </label>
                        <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 cursor-pointer hover:bg-slate-50 has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-50/50 transition">
                            <input type="radio" name="pace" value="brisk" class="mt-1 accent-emerald-600" />
                            <div>
                                <div class="font-medium">Brisk Walking (6.0 km/h)</div>
                                <div class="text-sm text-slate-500">Elevated minute-volume ventilation.</div>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Field 3: Sensitivity -->
                <div class="flex flex-col gap-3">
                    <label class="font-semibold text-slate-800">Respiratory Sensitivity Profile</label>
                    <div class="flex flex-col gap-2">
                        <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 cursor-pointer hover:bg-slate-50 has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-50/50 transition">
                            <input type="radio" name="sensitivity" value="standard" checked class="mt-1 accent-emerald-600" />
                            <div>
                                <div class="font-medium">Standard Commuter</div>
                                <div class="text-sm text-slate-500">Balanced distance and exposure routing.</div>
                            </div>
                        </label>
                        <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 cursor-pointer hover:bg-slate-50 has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-50/50 transition">
                            <input type="radio" name="sensitivity" value="sensitive" class="mt-1 accent-emerald-600" />
                            <div>
                                <div class="font-medium">Respiratory Sensitive / Asthma</div>
                                <div class="text-sm text-slate-500">Strict avoidance of PM10 dust and unpaved shoulders.</div>
                            </div>
                        </label>
                        <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 cursor-pointer hover:bg-slate-50 has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-50/50 transition">
                            <input type="radio" name="sensitivity" value="senior" class="mt-1 accent-emerald-600" />
                            <div>
                                <div class="font-medium">Senior / Child Escort</div>
                                <div class="text-sm text-slate-500">Prioritizes continuous paved sidewalks over detours.</div>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Action Button -->
                <button type="submit" class="mt-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 px-6 rounded-2xl w-full text-center transition">
                    Save Preferences to Device
                </button>
            </form>
        </div>

        <!-- Toast Notification -->
        <div id="toast" class="fixed bottom-4 left-1/2 -translate-x-1/2 bg-emerald-100 text-emerald-800 px-4 py-3 rounded-xl shadow-lg border border-emerald-200 font-medium transition-all duration-300 opacity-0 pointer-events-none translate-y-4">
            Profile saved locally!
        </div>
    </main>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('profile-form');
            const nameInput = document.getElementById('commuter-name');
            const paceRadios = document.getElementsByName('pace');
            const sensitivityRadios = document.getElementsByName('sensitivity');
            const toast = document.getElementById('toast');

            // Load from localStorage
            const savedData = localStorage.getItem('walksafe_profile');
            if (savedData) {
                try {
                    const profile = JSON.parse(savedData);
                    if (profile.name) nameInput.value = profile.name;
                    if (profile.pace) {
                        Array.from(paceRadios).forEach(radio => {
                            if (radio.value === profile.pace) radio.checked = true;
                        });
                    }
                    if (profile.sensitivity) {
                        Array.from(sensitivityRadios).forEach(radio => {
                            if (radio.value === profile.sensitivity) radio.checked = true;
                        });
                    }
                } catch (e) {
                    console.error('Error parsing profile data', e);
                }
            }

            // Save to localStorage
            form.addEventListener('submit', (e) => {
                e.preventDefault();
                
                const selectedPace = Array.from(paceRadios).find(r => r.checked)?.value || 'standard';
                const selectedSensitivity = Array.from(sensitivityRadios).find(r => r.checked)?.value || 'standard';

                const profile = {
                    name: nameInput.value.trim(),
                    pace: selectedPace,
                    sensitivity: selectedSensitivity
                };

                localStorage.setItem('walksafe_profile', JSON.stringify(profile));

                // Show toast
                toast.classList.remove('opacity-0', 'translate-y-4');
                toast.classList.add('opacity-100', 'translate-y-0');
                
                setTimeout(() => {
                    toast.classList.remove('opacity-100', 'translate-y-0');
                    toast.classList.add('opacity-0', 'translate-y-4');
                }, 3000);
            });
        });
    </script>
</body>
</html>
