---
import Layout from '../layouts/Layout.astro';
---
<Layout title="How to Use | WalkSafe">
    <div class="max-w-xl mx-auto px-4 py-8 md:py-12 min-h-[calc(100vh-3.5rem)] flex flex-col justify-center">
        <a href="/" class="text-sm font-semibold text-emerald-600 dark:text-[#00A8A8] flex items-center gap-1 mb-6 hover:text-emerald-700 w-fit transition">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
            Back to Home
        </a>

        <div class="bg-white dark:bg-[#1C1C1E] rounded-3xl border border-slate-200 dark:border-slate-700/50 shadow-xl p-6 md:p-8">
            <h1 class="text-2xl font-extrabold text-slate-900 dark:text-[#F7FAFC] mb-6 flex items-center gap-3">
                <svg class="w-7 h-7 text-emerald-600 dark:text-[#00A8A8]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477-4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                User Guide
            </h1>
            
            <div class="space-y-6">
                <div>
                    <span class="inline-block bg-slate-100 dark:bg-[#0B1F3A] text-slate-800 dark:text-[#F7FAFC] text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wide mb-2">Step 1</span>
                    <h3 class="text-sm font-bold text-slate-800 dark:text-[#F7FAFC] mb-1">Plan Your Clean Route</h3>
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400 leading-relaxed">Select your origin and destination. WalkSafe analyzes street-level pollution data to generate the most breathable walking path, balancing exposure against travel time.</p>
                </div>
                <div>
                    <span class="inline-block bg-slate-100 dark:bg-[#0B1F3A] text-slate-800 dark:text-[#F7FAFC] text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wide mb-2">Step 2</span>
                    <h3 class="text-sm font-bold text-slate-800 dark:text-[#F7FAFC] mb-1">Set Your Hazard Priorities</h3>
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400 leading-relaxed">Open the Commuter Menu and navigate to Hazard Priorities. Adjust the sensitivity sliders for dust, odor, smog, and vehicle idling based on your personal respiratory needs.</p>
                </div>
                <div>
                    <span class="inline-block bg-slate-100 dark:bg-[#0B1F3A] text-slate-800 dark:text-[#F7FAFC] text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wide mb-2">Step 3</span>
                    <h3 class="text-sm font-bold text-slate-800 dark:text-[#F7FAFC] mb-1">Report Street Hazards</h3>
                    <p class="text-xs font-medium text-slate-500 dark:text-slate-400 leading-relaxed">Help your community breathe easier. Drop a pin on the map to report temporary hazards like active construction dust or heavy traffic congestion.</p>
                </div>
            </div>
        </div>
    </div>
</Layout>
