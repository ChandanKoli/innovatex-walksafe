---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Plan Route | WalkSafe">
    <main class="flex-grow w-full px-4 sm:px-6 lg:px-8 py-8 flex flex-col items-center">
        <!-- In Development Badge -->
        <div class="flex justify-center mb-6">
            <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-amber-100 border border-amber-300 text-amber-800 text-sm font-bold shadow-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                In Development
            </span>
        </div>

        <!-- Center Card Container -->
        <div class="w-full max-w-xl bg-white border border-slate-200 shadow-xl rounded-2xl p-6 sm:p-8 mx-auto mt-10 flex flex-col gap-6">
            
            <div class="text-center">
                <h2 class="text-2xl font-bold text-slate-900 mb-1">Set Origin & Destination</h2>
                <p class="text-sm text-slate-500">Walksafe optimizes your path for minimal toxic particulate inhalation.</p>
            </div>

            <div class="flex flex-col relative">
                <!-- Origin Input -->
                <div class="flex flex-col gap-1.5 mb-2">
                    <label class="text-xs font-bold text-slate-500 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span> FROM (ORIGIN)
                    </label>
                    <div class="flex gap-2">
                        <input type="text" id="origin" placeholder="e.g., Station Transit Hub (Gate 1)" class="w-full bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition" />
                        <button type="button" class="whitespace-nowrap bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold px-4 rounded-xl border border-slate-200 transition">📍 Current</button>
                    </div>
                </div>

                <!-- Swap Button Row -->
                <div class="flex items-center justify-center -my-3 z-10 relative">
                   <button type="button" id="swap-btn" class="w-10 h-10 bg-white border border-slate-200 rounded-full shadow-sm flex items-center justify-center text-slate-500 hover:text-emerald-600 hover:border-emerald-300 hover:bg-emerald-50 transition" aria-label="Swap">
                       <span class="text-lg leading-none rotate-90">⇅</span>
                   </button>
                </div>

                <!-- Destination Input -->
                <div class="flex flex-col gap-1.5 mt-2">
                    <label class="text-xs font-bold text-slate-500 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-red-500"></span> TO (DESTINATION)
                    </label>
                    <input type="text" id="destination" placeholder="e.g., College Campus Gate" class="w-full bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition" />
                </div>
            </div>

            <!-- Quick Suggestion Chips -->
            <div class="flex flex-wrap gap-2 justify-center">
                <button type="button" class="chip px-3 py-1 text-xs font-medium bg-slate-100 text-slate-600 rounded-full border border-slate-200 hover:bg-slate-200 transition-colors">[Station Hub]</button>
                <button type="button" class="chip px-3 py-1 text-xs font-medium bg-slate-100 text-slate-600 rounded-full border border-slate-200 hover:bg-slate-200 transition-colors">[College Gate]</button>
                <button type="button" class="chip px-3 py-1 text-xs font-medium bg-slate-100 text-slate-600 rounded-full border border-slate-200 hover:bg-slate-200 transition-colors">[Market Square]</button>
                <button type="button" class="chip px-3 py-1 text-xs font-medium bg-slate-100 text-slate-600 rounded-full border border-slate-200 hover:bg-slate-200 transition-colors">[Colony Lane]</button>
            </div>

            <!-- Action Button -->
            <button id="find-route-btn" type="button" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-4 px-6 rounded-2xl w-full sm:w-auto text-center shadow-sm text-base transition mt-2">
                Find Clean-Air Route ➔
            </button>

            <!-- Footer Callout -->
            <div class="mt-6 flex items-start gap-3 p-4 bg-emerald-50 border border-emerald-200 rounded-xl text-emerald-800 text-sm">
                <span class="text-base leading-none">🛡️</span>
                <span><strong>Active Exposure Engine:</strong> Evaluates PM10 road cutting, idling auto queues, and tree shade corridors.</span>
            </div>
            
        </div>
    </main>

    <script>
        // Client-side interactions
        document.addEventListener('DOMContentLoaded', () => {
            const originInput = document.getElementById('origin') as HTMLInputElement;
            const destInput = document.getElementById('destination') as HTMLInputElement;
            const swapBtn = document.getElementById('swap-btn');
            const chips = document.querySelectorAll('.chip');
            const findRouteBtn = document.getElementById('find-route-btn');

            // Swap functionality
            swapBtn?.addEventListener('click', () => {
                const temp = originInput.value;
                originInput.value = destInput.value;
                destInput.value = temp;
            });

            // Chip auto-fill (fills empty input, prioritizes dest if origin is filled)
            chips.forEach(chip => {
                chip.addEventListener('click', (e) => {
                    let text = (e.target as HTMLElement).textContent?.trim() || '';
                    // Remove brackets
                    text = text.replace(/^\[/, '').replace(/\]$/, '');
                    
                    if (!originInput.value) {
                        originInput.value = text;
                    } else if (!destInput.value) {
                        destInput.value = text;
                    } else {
                        // If both filled, override dest just for UX ease
                        destInput.value = text;
                    }
                });
            });

            // Find route redirection
            findRouteBtn?.addEventListener('click', () => {
                const from = encodeURIComponent(originInput.value || 'station');
                const to = encodeURIComponent(destInput.value || 'college');
                window.location.href = `/pin?from=${from}&to=${to}`;
            });
        });
    </script>
</Layout>
