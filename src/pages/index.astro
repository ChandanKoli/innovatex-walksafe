---
import Layout from '../layouts/Layout.astro';
---
<Layout title="WalkSafe | Clean-Air Routing">
    <!-- Splash Preloader -->
    <div id="splash" class="fixed inset-0 z-[100] flex flex-col justify-center items-center bg-slate-50 transition-opacity duration-500">
        <svg class="w-24 h-24 text-emerald-600 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 22V16M12 16C12 16 7 16 7 11C7 6 12 5 12 5C12 5 17 6 17 11C17 16 12 16 12 16Z"/>
        </svg>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">WalkSafe</h1>
    </div>

    <!-- Hero Section -->
    <div class="max-w-6xl mx-auto px-4 py-8 md:py-16">
        <!-- Quote Banner -->
        <div class="max-w-lg mx-auto mb-10 text-xs font-semibold text-slate-500 bg-white border border-slate-200 py-2 px-5 rounded-full text-center shadow-sm">
            Google Maps shows the shortest road. Walksafe shows the cleanest sidewalk.
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
            <!-- Left Card -->
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 text-center">
                <svg class="w-12 h-12 mx-auto mb-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                <h3 class="font-bold text-slate-900">Exposure-Aware</h3>
                <p class="text-xs text-slate-500 mt-1">Smart Routing</p>
            </div>

            <!-- Center Action Hub -->
            <div class="bg-white rounded-3xl border border-slate-200 shadow-xl p-6 md:p-8 flex flex-col gap-4 text-center z-10 transform md:scale-105">
                <div>
                    <h2 class="text-2xl font-extrabold text-slate-900 mb-1">Start Your Clean Walk</h2>
                    <p class="text-sm text-slate-500 mb-6">Avoid unsuppressed dust, stagnant exhaust, and open odor.</p>
                </div>
                
                <a href="/plan" class="block w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-4 rounded-2xl shadow-sm transition">
                    Plan Clean Walk
                </a>
                
                <div class="flex flex-col sm:flex-row gap-3 mt-2">
                    <a href="/pin" class="flex-1 flex items-center justify-center gap-2 py-3 bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold rounded-xl border border-slate-200 text-sm transition">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.243-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                        Pin on Map
                    </a>
                    <a href="/demo" class="flex-1 flex items-center justify-center gap-2 py-3 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 font-semibold rounded-xl border border-emerald-200 text-sm transition">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                        Showcase Demo
                    </a>
                </div>
            </div>

            <!-- Right Card -->
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 text-center">
                <svg class="w-12 h-12 mx-auto mb-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>
                <h3 class="font-bold text-slate-900">Microclimate</h3>
                <p class="text-xs text-slate-500 mt-1">Cool Canopy</p>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="border-t border-slate-200 bg-white py-6 px-6 mt-12 text-center text-xs text-slate-500 flex flex-col md:flex-row justify-between items-center gap-4 max-w-6xl mx-auto">
        <p>Walksafe — Pedestrian-First Air Quality Exposure Engine for InnovateX 2026.</p>
        <div class="flex gap-4 font-medium text-slate-400">
            <a href="#" class="hover:text-emerald-600 transition">Methodology</a>
            <a href="#" class="hover:text-emerald-600 transition">Theme 2: Urban AQI</a>
            <a href="#" class="hover:text-emerald-600 transition">GitHub</a>
        </div>
    </footer>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(() => {
                const splash = document.getElementById('splash');
                if(splash) {
                    splash.style.opacity = '0';
                    setTimeout(() => {
                        splash.style.pointerEvents = 'none';
                        splash.style.display = 'none';
                    }, 500);
                }
            }, 600);
        });
    </script>
</Layout>
