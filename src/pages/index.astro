---
import '../styles/global.css';
---
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Home — WalkSafe</title>
</head>
<body class="bg-slate-50 text-slate-900 font-sans min-h-screen flex flex-col antialiased">
    
    <!-- Splash Preloader -->
    <div id="splash" class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-white transition-opacity duration-500 ease-out">
        <div class="w-16 h-16 bg-emerald-600 rounded-full flex items-center justify-center mb-4 shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"></path>
            </svg>
        </div>
        <h1 class="text-xl font-bold text-slate-900">WalkSafe — Pedestrian Clean-Air Engine</h1>
    </div>

    <!-- Global Header Bar -->
    <header class="bg-emerald-600 text-white px-6 py-3.5 flex items-center justify-between shadow-sm sticky top-0 z-40">
        <div class="flex items-center">
            <a href="/profile" class="mr-3 w-8 h-8 rounded-full bg-emerald-700/50 flex items-center justify-center hover:bg-emerald-700 transition" aria-label="Profile">
                <svg class="w-4 h-4 text-emerald-50" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
            </a>
            <span class="font-bold text-lg tracking-wide">Walksafe</span>
            <span class="bg-emerald-700/60 text-emerald-100 text-xs px-2.5 py-0.5 rounded-full font-medium ml-2">Mumbai</span>
        </div>
        <div class="flex items-center gap-3">
            <a href="/demo-select" class="bg-white text-emerald-800 font-bold px-3 py-1 rounded-xl text-sm shadow-sm hover:bg-emerald-50 transition">
                Demo
            </a>
            <a href="/menu" class="w-8 h-8 rounded-full bg-emerald-700/50 flex items-center justify-center hover:bg-emerald-700 transition" aria-label="Menu">
                <svg class="w-5 h-5 text-emerald-50" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </a>
        </div>
    </header>

    <!-- Main Hero Stage -->
    <main class="flex-grow flex flex-col items-center justify-center px-4 py-8 max-w-6xl mx-auto w-full">
        <!-- Top quote pill banner -->
        <div class="max-w-lg mx-auto mb-8 text-xs font-semibold text-slate-500 bg-white border border-slate-200 py-1.5 px-4 rounded-full text-center shadow-sm">
            Google Maps shows the shortest road. Walksafe shows the cleanest sidewalk.
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full items-center">
            
            <!-- Left Card -->
            <div class="hidden md:flex flex-col items-center text-center bg-white p-6 rounded-3xl border border-slate-200 shadow-sm h-full justify-between overflow-hidden">
                <!-- Left Vector Art -->
                <div class="w-full flex-grow flex items-center justify-center mb-4 relative">
                    <svg class="w-full max-w-[180px] h-auto" viewBox="0 0 200 150" xmlns="http://www.w3.org/2000/svg">
                        <!-- Background Cityscape -->
                        <path d="M20,130 L20,70 L40,70 L40,130 Z" fill="#e2e8f0"/>
                        <path d="M45,130 L45,50 L75,50 L75,130 Z" fill="#cbd5e1"/>
                        <path d="M80,130 L80,30 L120,30 L120,130 Z" fill="#e2e8f0"/>
                        <path d="M125,130 L125,60 L160,60 L160,130 Z" fill="#cbd5e1"/>
                        <path d="M165,130 L165,80 L185,80 L185,130 Z" fill="#e2e8f0"/>
                        
                        <!-- Emerald Sidewalk -->
                        <path d="M0,140 Q100,120 200,140 L200,150 L0,150 Z" fill="#059669" opacity="0.8"/>
                        
                        <!-- Pedestrians -->
                        <circle cx="80" cy="110" r="6" fill="#334155"/>
                        <path d="M75,118 L85,118 L88,140 L72,140 Z" fill="#334155"/>
                        
                        <circle cx="110" cy="115" r="5" fill="#475569"/>
                        <path d="M106,122 L114,122 L116,140 L104,140 Z" fill="#475569"/>
                        
                        <!-- Clean air waves -->
                        <path d="M30,90 Q50,70 70,90 T110,90" fill="none" stroke="#10b981" stroke-width="2" opacity="0.6" stroke-dasharray="4 4"/>
                        <path d="M90,70 Q110,50 130,70 T170,70" fill="none" stroke="#10b981" stroke-width="2" opacity="0.6" stroke-dasharray="4 4"/>
                        
                        <!-- Sun/Shine -->
                        <circle cx="170" cy="30" r="15" fill="#fde047" opacity="0.8"/>
                    </svg>
                </div>
                <div class="mt-auto flex flex-col items-center">
                    <span class="font-bold text-slate-800 text-lg mb-2">Exposure-Aware</span>
                    <span class="bg-emerald-100 text-emerald-800 text-xs font-semibold px-2.5 py-0.5 rounded-full border border-emerald-200">Smart Routing</span>
                </div>
            </div>

            <!-- Center Action Hub -->
            <div class="w-full max-w-md bg-white rounded-3xl border border-slate-200 shadow-md p-6 flex flex-col gap-4 text-center mx-auto relative z-10">
                <div class="mb-1">
                    <h2 class="text-2xl font-bold text-slate-900 mb-1">Start Your Clean Walk</h2>
                    <p class="text-sm text-slate-500">Avoid unsuppressed dust, stagnant exhaust, and open odor.</p>
                </div>
                
                <a href="/plan" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 px-6 rounded-2xl shadow-sm transition block text-center w-full">
                    Plan Clean Walk (From - To)
                </a>
                
                <div class="grid grid-cols-2 gap-3 w-full">
                    <a href="/pin" class="bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold py-3 px-4 rounded-2xl border border-slate-200 text-sm transition flex items-center justify-center gap-1.5">
                        <span class="text-lg">📍</span> Pin on Map
                    </a>
                    <a href="/demo-select" class="bg-emerald-50 hover:bg-emerald-100 text-emerald-700 font-semibold py-3 px-4 rounded-2xl border border-emerald-200 text-sm transition flex items-center justify-center gap-1.5">
                        <span class="text-lg">⚡</span> Showcase Demo
                    </a>
                </div>
            </div>

            <!-- Right Card -->
            <div class="hidden md:flex flex-col items-center text-center bg-white p-6 rounded-3xl border border-slate-200 shadow-sm h-full justify-between overflow-hidden">
                <!-- Right Vector Art -->
                <div class="w-full flex-grow flex items-center justify-center mb-4 relative">
                    <svg class="w-full max-w-[180px] h-auto" viewBox="0 0 200 150" xmlns="http://www.w3.org/2000/svg">
                        <!-- Tree canopies -->
                        <circle cx="50" cy="70" r="40" fill="#10b981" opacity="0.7"/>
                        <circle cx="100" cy="50" r="45" fill="#059669" opacity="0.9"/>
                        <circle cx="150" cy="70" r="35" fill="#10b981" opacity="0.8"/>
                        
                        <!-- Trunks -->
                        <rect x="45" y="110" width="10" height="30" fill="#78350f" rx="2"/>
                        <rect x="94" y="95" width="12" height="45" fill="#78350f" rx="2"/>
                        <rect x="146" y="105" width="8" height="35" fill="#78350f" rx="2"/>
                        
                        <!-- Ground -->
                        <path d="M0,140 Q100,130 200,140 L200,150 L0,150 Z" fill="#e2e8f0"/>
                        
                        <!-- Shielding breeze lines -->
                        <path d="M20,40 Q50,20 80,40 T140,40" fill="none" stroke="#ffffff" stroke-width="3" opacity="0.6" stroke-linecap="round"/>
                        <path d="M60,60 Q90,40 120,60 T180,60" fill="none" stroke="#ffffff" stroke-width="2" opacity="0.5" stroke-linecap="round"/>
                        
                        <!-- Leaf motifs -->
                        <path d="M40,90 Q50,85 55,95 Q45,100 40,90" fill="#a7f3d0"/>
                        <path d="M120,80 Q130,75 135,85 Q125,90 120,80" fill="#a7f3d0"/>
                        <path d="M160,40 Q170,35 175,45 Q165,50 160,40" fill="#a7f3d0"/>
                    </svg>
                </div>
                <div class="mt-auto flex flex-col items-center">
                    <span class="font-bold text-slate-800 text-lg mb-2">Microclimate</span>
                    <span class="bg-blue-100 text-blue-800 text-xs font-semibold px-2.5 py-0.5 rounded-full border border-blue-200">Cool Canopy</span>
                </div>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="mt-auto border-t border-slate-200 bg-white py-5 px-6 text-center text-xs text-slate-500 w-full">
        <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-3">
            <span>Walksafe — Pedestrian-First Air Quality Exposure Engine for InnovateX 2026.</span>
            <div class="flex gap-4 font-medium">
                <a href="#" class="hover:text-emerald-600 transition">Methodology</a>
                <a href="#" class="hover:text-emerald-600 transition">Theme 2: Urban AQI</a>
                <a href="#" class="hover:text-emerald-600 transition">GitHub</a>
            </div>
        </div>
    </footer>

    <script>
        window.addEventListener('load', () => {
            const splash = document.getElementById('splash');
            if (splash) {
                setTimeout(() => {
                    splash.style.opacity = '0';
                    splash.style.pointerEvents = 'none';
                }, 600);
            }
        });
    </script>
</body>
</html>
